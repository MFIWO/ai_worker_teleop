<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ffw_loop_streamer</name>
  <version>0.1.0</version>
  <description>Config Loop streamer sidecar for the ROBOTIS AI Worker: streams robot state/action and cameras from ffw_bringup topics to Config Loop (loop-sdk 0.4.1).</description>
  <maintainer email="tony@config.inc">Tony Lee</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ffw_bringup</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- pip: loop-sdk>=0.4.1,<0.5 (installed offline on the robot) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
